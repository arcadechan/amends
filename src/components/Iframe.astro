---
interface Props {
  code: string;
}

// Code should always be a trusted static iframe embed string since it originates from the CMS
// (e.g., YouTube/Spotify oEmbed). Do not pass unsanitized user input.
const { code } = Astro.props;
---

<div set:html={code} />

<style lang="scss">
  div {
    text-align: center;
    width: 100%;
    margin: 20px auto;

    :global(iframe) {
      width: 100%;
      height: 483px;
    }
  }
</style>
